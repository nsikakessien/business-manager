<Window x:Class="BusinessManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Business Manager"
        Height="780"
        Width="1280"
        MinHeight="560"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Background="{StaticResource Sidebar}">
            <StackPanel DockPanel.Dock="Top" Margin="20,24,20,24">
                <TextBlock Text="Business Manager" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Inventory · Sales · Accounts" Foreground="#9CA3AF" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                <Button Content="Back up now"
                        Command="{Binding BackupNowCommand}"
                        Background="Transparent" Foreground="#D1D5DB" BorderBrush="#374151"
                        Margin="0,0,0,6" />
                <Button Content="Open backups folder"
                        Command="{Binding OpenBackupFolderCommand}"
                        Background="Transparent" Foreground="#9CA3AF" BorderThickness="0"
                        FontSize="12" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Navigation}"
                     SelectedItem="{Binding SelectedNavigation}"
                     Background="Transparent"
                     BorderThickness="0"
                     AutomationProperties.Name="Navigation"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#D1D5DB" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome" Margin="8,2" Padding="12,10" CornerRadius="6" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="#1F2937" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="#1D4ED8" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Title}">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Page -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="28,24,28,24" Focusable="False" />
    </Grid>
</Window>
