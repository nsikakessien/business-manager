<Window x:Class="BusinessManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Business Manager"
        Height="520"
        Width="900"
        MinHeight="400"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid Margin="32">
        <Border Padding="32"
                Background="White"
                CornerRadius="12">

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Business Manager"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="#111827" />

                <TextBlock Margin="0,12,0,0"
                           Text="Inventory, sales, and customer accounts."
                           FontSize="18"
                           Foreground="#4B5563"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,24,0,0"
                           Text="Your business workspace starts here."
                           FontSize="14"
                           Foreground="#6B7280" />
            </StackPanel>
        </Border>
    </Grid>
</Window>