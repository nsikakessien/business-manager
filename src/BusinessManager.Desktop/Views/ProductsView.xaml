<UserControl x:Class="BusinessManager.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="3">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="New product" Style="{StaticResource PrimaryButton}" Command="{Binding NewProductCommand}" />
            </StackPanel>
            <TextBlock Text="Products &amp; stock" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <ContentControl Grid.Row="1" Grid.ColumnSpan="3" Content="{Binding}"
                        ContentTemplate="{StaticResource MessagesTemplate}" Focusable="False" />

        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search products" ToolTip="Search by SKU or name" Margin="0,0,16,0" />
            <CheckBox Content="Low stock only" IsChecked="{Binding LowStockOnly}" />
            <CheckBox Content="Show archived" IsChecked="{Binding IncludeArchived}" />
        </WrapPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" BorderThickness="0">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="110" ElementStyle="{StaticResource RightAligned}" />
                    <DataGridTemplateColumn Header="In stock" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding QuantityOnHand, StringFormat=N0}" HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Reorder at" Binding="{Binding ReorderLevel, StringFormat=N0}" Width="100" ElementStyle="{StaticResource RightAligned}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Previous" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
                <Button Content="Next" Command="{Binding NextPageCommand}" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}">
                <Run Text="{Binding TotalCount, Mode=OneWay, StringFormat={}{0:N0} products}" /><Run Text=" · page " /><Run Text="{Binding Page, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding PageCount, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>

        <!-- Editor and stock -->
        <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="SKU / barcode" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditSku, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                             IsReadOnly="{Binding HasSelection}" CharacterCasing="Upper" AutomationProperties.Name="SKU" />
                    <TextBlock Text="The SKU cannot be changed after the product is created." Style="{StaticResource Muted}"
                               FontSize="11" Margin="0,2,0,0" Visibility="{Binding HasSelection, Converter={StaticResource VisibleIf}}" />

                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Name" />

                    <TextBlock Text="Selling price" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditPrice, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Selling price" />

                    <TextBlock Text="Reorder level (0 = no alert)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditReorderLevel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Reorder level" />

                    <StackPanel Visibility="{Binding IsNew, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="Opening stock" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding EditOpeningStock, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Opening stock" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveProductCommand}" Margin="0,0,8,0" />
                        <Button Command="{Binding ToggleArchiveCommand}" Visibility="{Binding HasSelection, Converter={StaticResource VisibleIf}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                    <Setter Property="Content" Value="Archive" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProduct.IsActive}" Value="False">
                                            <Setter Property="Content" Value="Restore" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Stock -->
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource VisibleIf}}" Margin="0,24,0,0">
                        <Separator Margin="0,0,0,16" />
                        <TextBlock Style="{StaticResource SectionTitle}">
                            <Run Text="Stock:" /> <Run Text="{Binding SelectedProduct.QuantityOnHand, Mode=OneWay, StringFormat=N0}" /> <Run Text="on hand" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Receive delivery" IsChecked="{Binding IsReceiving}" GroupName="StockMode" />
                            <RadioButton Content="Adjust (count, damage…)" GroupName="StockMode" />
                        </StackPanel>

                        <TextBlock Text="Quantity (use a minus sign to remove stock when adjusting)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Stock quantity" />

                        <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding StockReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Reason" />

                        <Button Content="Apply" Command="{Binding ApplyStockCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />

                        <TextBlock Text="Recent movements" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
                        <ItemsControl ItemsSource="{Binding Movements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding QuantityChange, Converter={StaticResource Signed}}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding QuantityAfter, StringFormat=→ {0:N0}}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                                <Run Text="{Binding Type, Mode=OneWay, Converter={StaticResource EnumDisplay}}" /><Run Text=" · " /><Run Text="{Binding OccurredAtUtc, Mode=OneWay, Converter={StaticResource LocalTime}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
