<UserControl x:Class="BusinessManager.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="3">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="New customer" Style="{StaticResource PrimaryButton}" Command="{Binding NewCustomerCommand}" />
            </StackPanel>
            <TextBlock Text="Customers" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <ContentControl Grid.Row="1" Grid.ColumnSpan="3" Content="{Binding}"
                        ContentTemplate="{StaticResource MessagesTemplate}" Focusable="False" />

        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search customers" ToolTip="Name, phone or email" Margin="0,0,16,0" />
            <CheckBox Content="Owing money only" IsChecked="{Binding WithBalanceOnly}" />
            <CheckBox Content="Show archived" IsChecked="{Binding IncludeArchived}" />
        </WrapPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" BorderThickness="0">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="140" />
                    <DataGridTextColumn Header="Credit limit" Binding="{Binding CreditLimit, StringFormat=N2}" Width="110" ElementStyle="{StaticResource RightAligned}" />
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" Width="110" ElementStyle="{StaticResource RightAligned}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Previous" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
                <Button Content="Next" Command="{Binding NextPageCommand}" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}">
                <Run Text="{Binding TotalCount, Mode=OneWay, StringFormat={}{0:N0} customers}" /><Run Text=" · page " /><Run Text="{Binding Page, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding PageCount, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>

        <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Name" />

                    <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" AutomationProperties.Name="Phone" />

                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" AutomationProperties.Name="Email" />

                    <TextBlock Text="Credit limit (0 = must pay in full)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditCreditLimit, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Credit limit" />

                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCustomerCommand}" Margin="0,0,8,0" />
                        <Button Command="{Binding ToggleArchiveCommand}" Visibility="{Binding HasSelection, Converter={StaticResource VisibleIf}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                    <Setter Property="Content" Value="Archive" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomer.IsActive}" Value="False">
                                            <Setter Property="Content" Value="Restore" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Account -->
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource VisibleIf}}" Margin="0,24,0,0">
                        <Separator Margin="0,0,0,16" />
                        <TextBlock Text="Account" Style="{StaticResource SectionTitle}" />
                        <TextBlock FontSize="20" FontWeight="SemiBold"
                                   Text="{Binding SelectedCustomer.Balance, StringFormat=Balance: {0:N2}}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="{Binding SelectedCustomer.AvailableCredit, StringFormat=Credit available: {0:N2}}" />

                        <TextBlock Text="Record a payment" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Full balance" Style="{StaticResource LinkButton}"
                                    Command="{Binding PayFullBalanceCommand}" />
                            <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payment amount" />
                        </DockPanel>
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Margin="0,6,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Text="{Binding PaymentNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Margin="0,6,0,0"
                                 AutomationProperties.Name="Payment note" ToolTip="Optional note, e.g. receipt or transfer reference" />
                        <Button Content="Record payment" Command="{Binding RecordPaymentCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />

                        <TextBlock Text="Statement" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
                        <ItemsControl ItemsSource="{Binding Transactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right">
                                            <TextBlock Text="{Binding Amount, Converter={StaticResource Signed}}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding BalanceAfter, StringFormat=→ {0:N2}}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                                <Run Text="{Binding Type, Mode=OneWay, Converter={StaticResource EnumDisplay}}" /><Run Text=" · " /><Run Text="{Binding OccurredAtUtc, Mode=OneWay, Converter={StaticResource LocalTime}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
