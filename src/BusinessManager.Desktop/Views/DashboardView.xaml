<UserControl x:Class="BusinessManager.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
            </DockPanel>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessagesTemplate}" Focusable="False" />

            <UniformGrid Columns="4" Margin="0,0,-16,0">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Sales today" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Summary.RevenueToday, StringFormat=N2, FallbackValue=–}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding Summary.SalesToday, StringFormat={}{0:N0} transactions}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Last 7 days" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Summary.Revenue7Days, StringFormat=N2, FallbackValue=–}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Completed sales only" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Owed by customers" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Summary.TotalReceivables, StringFormat=N2, FallbackValue=–}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding Summary.CustomersOwing, StringFormat={}{0:N0} customers with a balance}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Stock alerts" Style="{StaticResource Muted}" />
                        <TextBlock Style="{StaticResource StatValue}" Foreground="{StaticResource Warning}"
                                   Text="{Binding Summary.LowStockProducts, StringFormat={}{0:N0} low, FallbackValue=–}" />
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text="{Binding Summary.OutOfStockProducts, Mode=OneWay, StringFormat={}{0:N0}}" />
                            <Run Text="out of stock of" />
                            <Run Text="{Binding Summary.ActiveProducts, Mode=OneWay, StringFormat={}{0:N0}}" />
                            <Run Text="products" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Revenue, last 7 days" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Days}" Height="200">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="8,0">
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" HorizontalAlignment="Center"
                                               Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Revenue, StringFormat=N0}" HorizontalAlignment="Center"
                                                   FontSize="11" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                        <Border Height="{Binding BarHeight}" Background="{StaticResource Accent}"
                                                CornerRadius="4,4,0,0" MaxWidth="56"
                                                ToolTip="{Binding SaleCount, StringFormat={}{0} sales}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
