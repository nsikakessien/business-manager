<UserControl x:Class="BusinessManager.Desktop.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="3">
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
            <TextBlock Text="Sales" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <ContentControl Grid.Row="1" Grid.ColumnSpan="3" Content="{Binding}"
                        ContentTemplate="{StaticResource MessagesTemplate}" Focusable="False" />

        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search sales" ToolTip="Sale number or customer name" Margin="0,0,12,0" />
            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,12,0" />
            <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,12,0" />
            <Button Content="Today" Command="{Binding TodayCommand}" Margin="0,0,8,0" />
            <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Margin="0,0,12,0" />
            <CheckBox Content="Show voided" IsChecked="{Binding IncludeVoided}" />
        </WrapPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}" BorderThickness="0">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Voided">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="100" />
                    <DataGridTextColumn Header="Date" Binding="{Binding OccurredAtUtc, Converter={StaticResource LocalTime}}" Width="150" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName, TargetNullValue=Walk-in}" Width="*" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="110" ElementStyle="{StaticResource RightAligned}" />
                    <DataGridTextColumn Header="On account" Binding="{Binding AmountOnAccount, StringFormat=N2}" Width="110" ElementStyle="{StaticResource RightAligned}" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource EnumDisplay}}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Previous" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
                <Button Content="Next" Command="{Binding NextPageCommand}" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}">
                <Run Text="{Binding TotalCount, Mode=OneWay, StringFormat={}{0:N0} sales}" /><Run Text=" · page " /><Run Text="{Binding Page, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding PageCount, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>

        <!-- Details -->
        <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <TextBlock Text="Select a sale to see its details." Style="{StaticResource Muted}"
                           Visibility="{Binding Details, Converter={StaticResource CollapsedIf}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Details, Converter={StaticResource VisibleIf}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}">
                            <Run Text="Sale" /> <Run Text="{Binding Details.Number, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Details.OccurredAtUtc, Converter={StaticResource LocalTime}, ConverterParameter=F}" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Details.CustomerName, StringFormat=Customer: {0}, TargetNullValue=Walk-in customer}" Margin="0,4,0,0" />

                        <Border Background="{StaticResource DangerSoft}" CornerRadius="6" Padding="10" Margin="0,12,0,0"
                                Visibility="{Binding CanVoid, Converter={StaticResource CollapsedIf}}">
                            <StackPanel>
                                <TextBlock Text="Voided" FontWeight="SemiBold" Foreground="{StaticResource Danger}" />
                                <TextBlock Text="{Binding Details.VoidedAtUtc, Converter={StaticResource LocalTime}}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Details.VoidReason}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Details.Lines}" Margin="0,16,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LineTotal, StringFormat=N2}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProductName}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                                <Run Text="{Binding Sku, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Quantity, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding UnitPrice, Mode=OneWay, StringFormat=N2}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,4,0,8" />
                        <TextBlock Text="{Binding Details.Subtotal, StringFormat=Subtotal: {0:N2}}" />
                        <TextBlock Text="{Binding Details.Discount, StringFormat=Discount: {0:N2}}" />
                        <TextBlock Text="{Binding Details.Total, StringFormat=Total: {0:N2}}" FontWeight="SemiBold" FontSize="16" Margin="0,4" />
                        <TextBlock>
                            <Run Text="{Binding Details.AmountPaid, Mode=OneWay, StringFormat=Paid: {0:N2}}" />
                            <Run Text="{Binding Details.PaymentMethod, Mode=OneWay, Converter={StaticResource EnumDisplay}, StringFormat=({0})}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Details.AmountOnAccount, StringFormat=On account: {0:N2}}" />
                        <TextBlock Text="{Binding Details.Notes}" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding Details.Notes, Converter={StaticResource VisibleIf}}" />

                        <Button Content="Void sale…" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                                Margin="0,20,0,0" Command="{Binding VoidSaleCommand}"
                                Visibility="{Binding CanVoid, Converter={StaticResource VisibleIf}}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
