<UserControl x:Class="BusinessManager.Desktop.Views.PointOfSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="3">
            <Button DockPanel.Dock="Right" Content="New sale" Command="{Binding NewSaleCommand}" VerticalAlignment="Top" />
            <TextBlock Text="New sale" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <ContentControl Grid.Row="1" Grid.ColumnSpan="3" Content="{Binding}"
                        ContentTemplate="{StaticResource MessagesTemplate}" Focusable="False" />

        <!-- Left: product search and cart -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add" Margin="8,0,0,0"
                        Command="{Binding AddProductCommand}" CommandParameter="{Binding SelectedProductResult}" />
                <TextBox x:Name="ProductSearch"
                         Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Find product by SKU, barcode or name"
                         ToolTip="Type or scan a SKU, then press Enter">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddFromSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding ProductResults}" SelectedItem="{Binding SelectedProductResult}"
                     MaxHeight="180" Margin="0,4,0,0"
                     Visibility="{Binding ProductResults.Count, Converter={StaticResource VisibleIf}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <DockPanel.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick"
                                              Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" />
                            </DockPanel.InputBindings>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SellingPrice, StringFormat=N2}" Margin="12,0,0,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding QuantityOnHand, StringFormat={}{0:N0} in stock}"
                                       Style="{StaticResource Muted}" Margin="12,0,0,0" />
                            <TextBlock>
                                <Run Text="{Binding Sku, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding Name, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                <DataGrid ItemsSource="{Binding Cart}" IsReadOnly="False" BorderThickness="0"
                          AutomationProperties.Name="Cart">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" IsReadOnly="True" Width="110" />
                        <DataGridTextColumn Header="Product" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" IsReadOnly="True" Width="100"
                                            ElementStyle="{StaticResource RightAligned}" />
                        <DataGridTemplateColumn Header="Qty" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="4,2" HorizontalContentAlignment="Right"
                                             AutomationProperties.Name="Quantity" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" IsReadOnly="True" Width="110"
                                            ElementStyle="{StaticResource RightAligned}" />
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource Danger}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                                        <Button Content="Remove" Style="{StaticResource LinkButton}"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Right: customer, payment, totals -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Customer (optional)" Style="{StaticResource SectionTitle}" />
                    <TextBox Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search customers" ToolTip="Search by name, phone or email" />
                    <ComboBox ItemsSource="{Binding CustomerResults}" SelectedItem="{Binding SelectedCustomer}"
                              Margin="0,6,0,0" AutomationProperties.Name="Customer">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11"
                                               Text="{Binding AvailableCredit, StringFormat=Credit available: {0:N2}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Clear customer" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                            Command="{Binding ClearCustomerCommand}"
                            Visibility="{Binding HasCustomer, Converter={StaticResource VisibleIf}}" />

                    <TextBlock Text="Discount" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Discount" />

                    <TextBlock Text="Payment method" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Amount received (leave blank if paid exactly)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding AmountReceivedText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Amount received" />

                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" />

                    <Separator Margin="0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Subtotal" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat=N2}" />
                        <TextBlock Grid.Row="1" Text="Discount" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Discount, StringFormat=-{0:N2}}" />
                        <TextBlock Grid.Row="2" Text="Total" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Total, StringFormat=N2}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,6" />
                        <TextBlock Grid.Row="3" Text="Paid now" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AmountPaid, StringFormat=N2}" />
                        <TextBlock Grid.Row="4" Text="On customer account" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OnAccount, StringFormat=N2}" />
                        <TextBlock Grid.Row="5" Text="Change due" FontWeight="SemiBold" Foreground="{StaticResource Success}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Change, StringFormat=N2}" FontWeight="SemiBold" Foreground="{StaticResource Success}" />
                    </Grid>

                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="{Binding ValidationMessage, Converter={StaticResource VisibleIf}}" />

                    <Button Content="Complete sale" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Padding="14,12"
                            FontSize="16" Command="{Binding CompleteSaleCommand}" />

                    <!-- Receipt for the last completed sale -->
                    <Border Background="#F9FAFB" CornerRadius="6" Padding="12" Margin="0,16,0,0"
                            Visibility="{Binding LastSale, Converter={StaticResource VisibleIf}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Receipt" />
                                <Run Text="{Binding LastSale.Number, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding LastSale.OccurredAtUtc, Converter={StaticResource LocalTime}}" Style="{StaticResource Muted}" />
                            <ItemsControl ItemsSource="{Binding LastSale.Lines}" Margin="0,8,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LineTotal, StringFormat=N2}" />
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Quantity, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding ProductName, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding LastSale.Total, StringFormat=Total: {0:N2}}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LastSale.AmountOnAccount, StringFormat=On account: {0:N2}}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
