<Application x:Class="BusinessManager.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BusinessManager.Desktop.ViewModels"
             xmlns:views="clr-namespace:BusinessManager.Desktop.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Each page view model is displayed by its view. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PointOfSaleViewModel}">
                <views:PointOfSaleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalesHistoryViewModel}">
                <views:SalesHistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                <views:ProductsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
                <views:CustomersView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
